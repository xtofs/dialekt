<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Precompiles on `dotnet publish -r <rid>`; avoids most JIT time in short-lived runs. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

<ItemGroup>
  <None Include="..\..\samples\*.langium" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>

<ItemGroup>
  <ProjectReference Include="..\dialekt\dialekt.csproj" />
  <ProjectReference Include="..\dialekt.grammar\dialekt.grammar.csproj" />
</ItemGroup>
  <ItemGroup>
    <Using Include="Dialekt.Langium" />
  </ItemGroup>
</Project>
